# ── Plivo ────────────────────────────────────────────────────────────────────
PLIVO_AUTH_ID=your_plivo_auth_id
PLIVO_AUTH_TOKEN=your_plivo_auth_token
PLIVO_PHONE_NUMBER=+1234567890

# ── Deepgram (STT + TTS fallback) ────────────────────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key

# ── ElevenLabs (TTS primary) ─────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# ELEVENLABS_VOICE_ID=EMh4QfWp9dtmYomyxDic
# ELEVENLABS_MODEL=eleven_flash_v2_5

# ── LLM provider chain ───────────────────────────────────────────────────────
# Primary and fallback roles are config-driven — swap without code changes.
# Default: OpenAI primary (more stable), Groq fallback (fast/cheap).

# OpenAI — required when LLM_PRIMARY_PROVIDER=openai (the default)
OPENAI_API_KEY=your_openai_api_key

# Groq — required when LLM_FALLBACK_PROVIDER=groq (the default)
GROQ_API_KEY=your_groq_api_key

LLM_PRIMARY_PROVIDER=openai
LLM_PRIMARY_MODEL=gpt-4o-mini
LLM_PRIMARY_TIMEOUT_S=8

LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_TIMEOUT_S=4

LLM_CIRCUIT_FAIL_THRESHOLD=2
LLM_CIRCUIT_COOLDOWN_S=120

# ── App ───────────────────────────────────────────────────────────────────────
BASE_URL=https://your-tunnel.ngrok.io
# HOST=0.0.0.0
# PORT=8000
# DEBUG_MODE=false

# ── TTS voice settings ───────────────────────────────────────────────────────
# TTS_STABILITY=0.4          # 0-1; lower = more expressive
# TTS_SIMILARITY_BOOST=0.85  # 0-1; higher = closer to voice clone
# TTS_STYLE=0.15             # 0-1; prosodic variation (raise to 0.25 if robotic)
# TTS_SPEAKER_BOOST=true
# TTS_SPEED=1.05             # 0.7-1.2; lower if too fast

# ── STT / silence detection ───────────────────────────────────────────────────
# DG_ENDPOINTING_MS=800     # PRIMARY silence timer — raise if agent interrupts
# DG_UTTERANCE_END_MS=1500
# ENDPOINT_MS=250           # coalescing buffer only — keep small, do NOT raise
# MIN_UTTERANCE_WORDS=2
# BARGE_IN_THRESHOLD=0.85

# ── Agent behaviour ───────────────────────────────────────────────────────────
# GREETING_MESSAGE=Good day, this is Saanvi...
# MAX_CONVERSATION_TURNS=30
# HANGUP_SILENCE_SECS=30.0
# SENTENCE_DELIMITERS=.!?

# ── Cost display ──────────────────────────────────────────────────────────────
# USD_TO_INR=83.5              # Manual USD→INR rate for dashboard display
